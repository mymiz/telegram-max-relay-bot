# Скопируйте в корень проекта: copy deploy\.env.example .env

TELEGRAM_BOT_TOKEN=123456789:AAH...
ADMIN_USER_IDS=123456789

# TELEGRAM_PROXY=http://127.0.0.1:10809
# REDIS_URL=redis://localhost:6379/0
# OWNER_USER_IDS=111,222
# Награда владельцу за принятый код (₽)
CODE_REWARD_RUB=50
# Rate limit для сообщений (секунды между сообщениями одного пользователя, дефолт 1.0)
RATE_LIMIT_SEC=1.0
# Rate limit для кнопок (секунды, дефолт 0.3 — быстрая навигация)
CALLBACK_RATE_SEC=0.3
